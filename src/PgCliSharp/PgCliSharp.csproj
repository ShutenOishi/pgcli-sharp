<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PgCliSharp</RootNamespace>
    <AssemblyName>PgCliSharp</AssemblyName>
    <PackageId>PgCliSharp</PackageId>
    <Title>PgCliSharp</Title>
    <Version>0.1.0-alpha.1</Version>
    <Authors>ShutenOishi</Authors>
    <Copyright>Copyright (c) 2026 ShutenOishi</Copyright>
    <Description>Strongly typed .NET wrapper for PostgreSQL command-line tools with PostgreSQL 10-18 compatibility.</Description>
    <PackageTags>postgresql;postgres;cli;pg_dump;pg_restore;pg_dumpall;backup;restore</PackageTags>
    <PackageProjectUrl>https://github.com/ShutenOishi/pgcli-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShutenOishi/pgcli-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>First public preview of the typed pg_dump, pg_restore, and pg_dumpall backup/restore core. / pg_dump・pg_restore・pg_dumpall の型付きバックアップ／リストア中核を含む初回公開プレビュー。</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../README.ja.md" Pack="true" PackagePath="/" Link="README.ja.md" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="CliWrap" Version="3.10.5" />
  </ItemGroup>
</Project>
