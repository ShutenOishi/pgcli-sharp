  "io": {
    "batch": "PsqlIo models finite caller-owned stdin/stdout/stderr. Ordered --command/--file actions use one-shot streaming execution.",
    "session": "PsqlSessionIo plus PsqlSession model a long-lived redirected duplex session. The session is programmatic pipe I/O, not TTY/PTY emulation.",
    "stderr": "Caller-owned stderr streaming is optional. When used, PsqlResult.StandardError is empty instead of retaining an unbounded duplicate."
  },
  "exitStatuses": {
    "0": "normal completion",
    "1": "fatal psql error",
    "2": "bad server connection in non-interactive mode",
    "3": "script error with ON_ERROR_STOP"
  },
